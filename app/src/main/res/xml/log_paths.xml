  Exactly the log directory, and nothing else. A FileProvider grants access to
  whatever it is pointed at, so pointing it at the whole of external-files would
  hand a share target the quirk file and anything else that lands there.
-->
<paths>
    <external-files-path name="logs" path="logs/" />
    <files-path name="internal-logs" path="logs/" />
</paths>
