<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark by default: this UI is read in a car, often in sunlight glare at
         night, and a white flash at 70 mph is a safety problem, not a taste one. -->
    <style name="Theme.Headway" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">#FF000000</item>
        <item name="android:statusBarColor">#FF000000</item>
    </style>

    <!--
      For ProjectionRequestActivity, whose entire visible output is the system's
      own consent sheet. A window background of any colour would flash over
      whatever the driver was looking at.
    -->
    <style name="Theme.Headway.Invisible" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
