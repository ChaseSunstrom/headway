<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Bluetooth: discovery and the wireless credentials handshake only.
      neverForLocation is load-bearing, not decoration: without it Android
      treats a BLE scan as a location request and the user is asked for
      location access, which Headway has no use for and will not request.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Joining the car's access point via WifiNetworkSpecifier. -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
      Pairing with the car's access point, so joining it stops asking.

      WifiNetworkFactory consults CompanionDeviceManager before it shows its
      approval sheet (WifiNetworkFactory.java L1862-L1877, reached from
      isAccessPointApprovedForActiveRequest L1880-L1899), and an app associated
      with the access point's BSSID is connected straight through with no UI at
      all. That is what makes reconnecting after a walk to the shops possible:
      a phone in a pocket cannot tap a sheet.

      No permission goes with it. The consent is the chooser the platform shows
      when associate() is called. Android has no Settings page that lists a
      profile-less Wi-Fi association, so Headway's own Unpair button is the way
      to revoke it; clearing the app's storage also drops it. required="false"
      because a device without
      the subsystem must still be able to install Headway; CarCompanion then
      degrades to "Android will ask for approval on every connection", which is
      exactly the behaviour of every build before this one.
    -->
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="false" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Required by ConnectivityManager.requestNetwork, which is how Headway joins
      the car's access point. It is a *normal* permission, granted at install and
      absent from the Settings permission list entirely — so when it is missing
      the failure cannot be fixed by granting anything, and reads to the user as
      "I already turned Wi-Fi permissions on and it still says they are
      required". Leaving it out cost exactly that diagnosis against a real car.
    -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!--
      Microphone. Needed for two things: the optional phone-mic fallback, and
      AudioPlaybackCapture, which is how third-party music reaches the car now
      that A2DP is known to go silent while the head unit is projecting (ADR
      0005). The car's own microphone arrives over AAP and needs no Android
      permission at all.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Starting the session on the driver's behalf when the car's Bluetooth
      appears.

      RECEIVE_BOOT_COMPLETED is what lets the receiver exist again after a
      reboot. The companion permission is what lets it start a foreground
      service from the background: Android 12 forbids that in general and
      exempts an app that holds an active CompanionDeviceManager association,
      which Headway already creates for the Wi-Fi approval bypass (CarCompanion).
      Both are protectionLevel="normal" -- granted at install, nothing asked of
      the driver. When the platform refuses anyway, the receiver posts a
      notification instead of failing quietly.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission
        android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />

    <!--
      Headway asks for no overlay permission.

      It used to: a floating microphone-and-Home window was drawn over whatever
      app was on the car screen, because opening an app replaced the dashboard
      entirely and there was otherwise no way back. ADR 0010 removed the reason —
      an app now renders inside a pane and the dashboard, with its rail and its
      microphone, is never left — so the window went, and SYSTEM_ALERT_WINDOW
      went with it. One fewer special access to explain and to grant.
    -->

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
      The phone pane. Four ordinary runtime permissions, each optional on its
      own: without them the pane says which one is missing rather than sitting
      empty.

      READ_CALL_LOG is the recent-calls list, which is most of what Android
      Auto's phone screen ever shows. READ_CONTACTS names the caller when the
      log has no cached name. CALL_PHONE places the call outright instead of
      handing the driver a filled-in dialer to press a button on, which is the
      whole difference between a car control and a phone control.
      ANSWER_PHONE_CALLS is only the backstop: the answer and hang-up
      PendingIntents the dialer publishes on its own notification are preferred
      and need nothing, but a dialer that publishes none leaves TelecomManager
      as the only route.

      None of these is privileged. All four are dangerous|runtime, granted by an
      ordinary prompt, and revocable in Settings.
    -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

    <!--
      The car-app template host claims two global names, and both of them live
      in src/host/AndroidManifest.xml rather than here.

      A permission name has one definer per device and a provider authority one
      owner, so on a phone where anything else holds either, an APK declaring
      them does not install at all. That took down every other feature with it
      and reported only "App not installed". The `host` flavour declares them
      and the `compat` flavour does not; see app/build.gradle.kts, ADR 0007 and
      BLOCKERS B-013 / B-014.
    -->


    <!--
      The in-app updater, which is entirely user-initiated: nothing checks for
      an update on launch, on a schedule, or in the background. The user has to
      grant "install unknown apps" for Headway as well, which is a normal
      per-app setting and not a privileged permission.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Declared but not required. Marking these required only changes Play Store
      filtering, which is irrelevant to an app distributed through F-Droid, while
      it makes the app uninstallable on any device lacking the hardware. That
      includes every CI emulator image, so requiring them would cost us all
      on-device testing and buy nothing. Headway checks for both radios at
      runtime and reports what is missing instead.
    -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <application
        android:name=".HeadwayApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Headway">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          There is deliberately no car-facing *activity* any more.

          The car screen is a Presentation on a display Headway creates, drawn by
          CarShell, and it never enters the activity-launch path at all -- which
          is the only reason it can be there: ActivityTaskSupervisor refuses the
          first activity onto an untrusted virtual display. The two activities
          that used to be declared here (a launcher and a dashboard, both drawn
          on display 0 and mirrored) went with mirroring itself. See ADR 0010.

          The practical consequence is the one the driver notices: bringing a
          session up starts nothing on the phone's screen.
        -->

        <!--
          Holds the AAP session, the network binding and the MediaProjection.
          mediaProjection is required from Android 14 for screen capture to
          survive; connectedDevice covers the Bluetooth/Wi-Fi link.
        -->
        <service
            android:name=".service.HeadwayService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|connectedDevice" />

        <!--
          Shares the exported log.

          Needed because the export dialog's own instructions could not be
          followed: the file lands in Android/data, and DocumentsUI has blocked
          navigation into that directory since Android 11, so "open the Files
          app and go to that folder" was advice to do something the platform
          forbids. A share sheet hands the file straight to a mail or chat app
          with a temporary read grant instead.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/log_paths" />
        </provider>

        <!--
          The car-connection provider is declared in the `host` flavour only,
          for the same reason as the permission above: an exclusive authority
          that another app may already own. See src/host/AndroidManifest.xml.
        -->


        <!--
          Delivers the install session's outcome. Not exported: the only sender
          is the system installer answering a PendingIntent Headway created, and
          the PendingIntent carries the delivery right on its own.
        -->
        <!--
          Wakes Headway when the car does.

          ACL_CONNECTED is one of the implicit broadcasts a manifest receiver may
          still register for after Android 8, which is the whole reason this can
          work with the app not running. BOOT_COMPLETED and MY_PACKAGE_REPLACED
          re-arm it after a reboot or an update.
        -->
        <receiver
            android:name=".link.CarPresenceReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".update.UpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.headway.app.INSTALL_STATUS" />
            </intent-filter>
        </receiver>

        <!--
          Gesture injection. This is the unprivileged path to synthesising touch
          from the car: dispatchGesture on an AccessibilityService. INJECT_EVENTS
          is a system permission and is out of scope by design.
        -->
        <!--
          The notification listener, which is two features at once and neither
          of them is "read the user's notifications for their own sake".

          It is what the Messages tile reads, and it is also the component whose
          enablement gates MediaSessionManager.getActiveSessions — so the Now
          Playing tile cannot see what is playing without it either. That is an
          Android design decision, not Headway's: transport control and
          notification access share one gate.

          A user-granted special access, in the same class as accessibility.
          BIND_NOTIFICATION_LISTENER_SERVICE is signature-level and held only by
          the system, which is what stops anything but the system binding this.
          exported=true is mandatory for a filtered service on S+, and is what
          lets the system bind it at all.
        -->
        <service
            android:name=".dash.tiles.HeadwayNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".input.HeadwayAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
