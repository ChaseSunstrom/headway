<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Bluetooth: discovery and the wireless credentials handshake only.
      neverForLocation is load-bearing, not decoration: without it Android
      treats a BLE scan as a location request and the user is asked for
      location access, which Headway has no use for and will not request.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Joining the car's access point via WifiNetworkSpecifier. -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
      Pairing with the car's access point, so joining it stops asking.

      WifiNetworkFactory consults CompanionDeviceManager before it shows its
      approval sheet (WifiNetworkFactory.java L1862-L1877, reached from
      isAccessPointApprovedForActiveRequest L1880-L1899), and an app associated
      with the access point's BSSID is connected straight through with no UI at
      all. That is what makes reconnecting after a walk to the shops possible:
      a phone in a pocket cannot tap a sheet.

      No permission goes with it. The consent is the chooser the platform shows
      when associate() is called. Android has no Settings page that lists a
      profile-less Wi-Fi association, so Headway's own Unpair button is the way
      to revoke it; clearing the app's storage also drops it. required="false"
      because a device without
      the subsystem must still be able to install Headway; CarCompanion then
      degrades to "Android will ask for approval on every connection", which is
      exactly the behaviour of every build before this one.
    -->
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="false" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Required by ConnectivityManager.requestNetwork, which is how Headway joins
      the car's access point. It is a *normal* permission, granted at install and
      absent from the Settings permission list entirely — so when it is missing
      the failure cannot be fixed by granting anything, and reads to the user as
      "I already turned Wi-Fi permissions on and it still says they are
      required". Leaving it out cost exactly that diagnosis against a real car.
    -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!--
      Microphone. Needed for two things: the optional phone-mic fallback, and
      AudioPlaybackCapture, which is how third-party music reaches the car now
      that A2DP is known to go silent while the head unit is projecting (ADR
      0005). The car's own microphone arrives over AAP and needs no Android
      permission at all.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      The floating microphone button, so a voice session can be started from
      inside another app rather than only from Headway's launcher. A user-granted
      special access, in the same class as the accessibility grant — not a
      privileged permission. Everything works without it; only the button is
      missing.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
      The phone pane. Four ordinary runtime permissions, each optional on its
      own: without them the pane says which one is missing rather than sitting
      empty.

      READ_CALL_LOG is the recent-calls list, which is most of what Android
      Auto's phone screen ever shows. READ_CONTACTS names the caller when the
      log has no cached name. CALL_PHONE places the call outright instead of
      handing the driver a filled-in dialer to press a button on, which is the
      whole difference between a car control and a phone control.
      ANSWER_PHONE_CALLS is only the backstop: the answer and hang-up
      PendingIntents the dialer publishes on its own notification are preferred
      and need nothing, but a dialer that publishes none leaves TelecomManager
      as the only route.

      None of these is privileged. All four are dangerous|runtime, granted by an
      ordinary prompt, and revocable in Settings.
    -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

    <!--
      The car-app template host, declared and then held by Headway itself.

      This is the single line that decides whether a third-party car app will
      talk to Headway at all, and it is worth stating exactly why it works.

      An app that offers a car UI does so through a CarAppService, and before it
      answers anything it runs HostValidator.isValidHost() in its own process.
      That method accepts a caller on four conditions and no others
      (HostValidator.validateHost, decompiled from androidx.car.app:app:1.7.0):
      the caller is the app itself; the caller's package and signing digest are
      in the allowlist the app hardcoded; the caller is uid 1000; or the caller
      holds android.car.permission.TEMPLATE_RENDERER, checked as
      REQUESTED_PERMISSION_GRANTED on the caller's own PackageInfo.

      Headway cannot be any of the first three. It can be the fourth, because a
      permission is just a name: an app may declare one and use it, and a
      signature-protected permission is granted at install to the package that
      declared it, itself. No root, no system signature, no adb, no
      privileged API. The permission names a role, and Headway genuinely
      performs that role: it renders car-app templates on a car screen.

      This is not impersonation and cannot become it. Headway still tells every
      app its real package name, and the library cross-checks that name against
      the real calling uid: HostValidator.validateHost looks the claimed package
      up and throws IllegalStateException when its uid does not match the
      HostInfo it was handed. CarAppBinder.onHandshakeCompleted supplies that
      HostInfo from Binder.getCallingUid() and does no checking of its own, so
      the guarantee lives one frame further in than an earlier version of this
      comment said. It is reached on the permission branch, which is the branch
      Headway takes. An app that would rather not talk to Headway can still
      refuse it by name.

      signature rather than normal, so nothing else on the phone can pick the
      permission up from Headway's declaration.

      The one real cost: a package that already declares this permission makes
      Headway fail to install with INSTALL_FAILED_DUPLICATE_PERMISSION. Nothing
      on an AOSP phone declares it: it belongs to Android Automotive's car
      service, which is not present. Google's Android Auto app might, so a
      phone running that alongside Headway is the case to watch. BLOCKERS B-013
      records it with the workaround.
    -->
    <permission
        android:name="android.car.permission.TEMPLATE_RENDERER"
        android:protectionLevel="signature" />
    <uses-permission android:name="android.car.permission.TEMPLATE_RENDERER" />

    <!--
      The in-app updater, which is entirely user-initiated: nothing checks for
      an update on launch, on a schedule, or in the background. The user has to
      grant "install unknown apps" for Headway as well, which is a normal
      per-app setting and not a privileged permission.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Declared but not required. Marking these required only changes Play Store
      filtering, which is irrelevant to an app distributed through F-Droid, while
      it makes the app uninstallable on any device lacking the hardware. That
      includes every CI emulator image, so requiring them would cost us all
      on-device testing and buy nothing. Headway checks for both radios at
      runtime and reports what is missing instead.
    -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Headway">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The car-facing launcher surface. Shown on the mirrored display; it is
          a separate activity from MainActivity so the phone screen and the car
          screen can show different things.
        -->
        <activity
            android:name=".ui.CarLauncherActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            tools:ignore="LockedOrientationActivity" />

        <!--
          The multi-pane dashboard. Landscape for the same reason the launcher
          is, and allowEmbedded because this activity is launched onto a virtual
          display Headway itself creates.

          On allowEmbedded specifically: the check at
          ActivityTaskSupervisor.isCallerAllowedToLaunchOnDisplay requires the
          *target* activity to declare it before it may be placed on a
          non-trusted virtual display. Headway also satisfies the alternative
          branch — the display's owner uid is its own — but declaring it costs
          nothing and removes a dependency on which branch the platform takes.
          It is emphatically not a way to host anyone else's activity: it is an
          opt-in each app makes for itself, which is exactly why third-party
          panes are impossible. See ADR 0004.
        -->
        <activity
            android:name=".dash.DashboardActivity"
            android:allowEmbedded="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            tools:ignore="LockedOrientationActivity" />

        <!--
          Holds the AAP session, the network binding and the MediaProjection.
          mediaProjection is required from Android 14 for screen capture to
          survive; connectedDevice covers the Bluetooth/Wi-Fi link.
        -->
        <service
            android:name=".service.HeadwayService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|connectedDevice" />

        <!--
          Shares the exported log.

          Needed because the export dialog's own instructions could not be
          followed: the file lands in Android/data, and DocumentsUI has blocked
          navigation into that directory since Android 11, so "open the Files
          app and go to that folder" was advice to do something the platform
          forbids. A share sheet hands the file straight to a mail or chat app
          with a temporary read grant instead.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/log_paths" />
        </provider>

        <!--
          The car-connection provider every car app queries to find out whether
          it is being projected.

          androidx.car.app.connection.CarConnection does not ask the system; it
          queries this well-known authority and reads one integer. On a phone
          with Android Auto installed, Gearhead answers it. On a de-Googled
          phone nothing does, and every car app concludes it is not in a car,
          which for several of them means refusing to run their car service at
          all. Headway answers with the truth about its own AAP session.

          Exported because the whole point is that other apps read it, and there
          is nothing to protect: the answer is whether a car is connected, which
          any app can already see from Bluetooth. Read-only; every write path in
          CarConnectionProvider is refused.

          The authority is exclusive, so a phone that already has Android Auto
          installed will refuse to install Headway with
          INSTALL_FAILED_CONFLICTING_PROVIDER. BLOCKERS B-014 records it and the
          way out; templates render either way.
        -->
        <provider
            android:name=".carapp.CarConnectionProvider"
            android:authorities="androidx.car.app.connection"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!--
          Delivers the install session's outcome. Not exported: the only sender
          is the system installer answering a PendingIntent Headway created, and
          the PendingIntent carries the delivery right on its own.
        -->
        <receiver
            android:name=".update.UpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.headway.app.INSTALL_STATUS" />
            </intent-filter>
        </receiver>

        <!--
          Gesture injection. This is the unprivileged path to synthesising touch
          from the car: dispatchGesture on an AccessibilityService. INJECT_EVENTS
          is a system permission and is out of scope by design.
        -->
        <!--
          The notification listener, which is two features at once and neither
          of them is "read the user's notifications for their own sake".

          It is what the Messages tile reads, and it is also the component whose
          enablement gates MediaSessionManager.getActiveSessions — so the Now
          Playing tile cannot see what is playing without it either. That is an
          Android design decision, not Headway's: transport control and
          notification access share one gate.

          A user-granted special access, in the same class as accessibility.
          BIND_NOTIFICATION_LISTENER_SERVICE is signature-level and held only by
          the system, which is what stops anything but the system binding this.
          exported=true is mandatory for a filtered service on S+, and is what
          lets the system bind it at all.
        -->
        <service
            android:name=".dash.tiles.HeadwayNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".input.HeadwayAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
