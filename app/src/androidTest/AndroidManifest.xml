<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          A real MediaBrowserService, so CarMediaBrowser can be driven against
          the actual framework rather than a mock of it.

          This is the only way to catch the class of bug that shipped here: the
          first version of CarMediaBrowser re-subscribed an id that was still
          subscribed, and MediaBrowserService.addSubscriptionOnHandler dedupes
          on (token, options) and silently returns without loading. No unit test
          with a stubbed browser can see that, because the behaviour lives
          entirely in the platform service.

          exported="true", and it has to be. AGP builds androidTest into a
          separate APK with its own applicationId (dev.headway.app.test), so the
          service lives in one package while MediaBrowser binds it from the
          target process in another. A non-exported service across that boundary
          is refused, and the refusal arrives as onConnectionFailed, which the
          browser correctly reports as "this app will not serve us", so every
          test failed with an empty root and no hint that the cause was the
          manifest. Nothing ships this APK, and the only thing behind the door
          is three fake tracks.
        -->
        <service
            android:name="dev.headway.app.media.FakeLibraryService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>
</manifest>
